{
	"operationId": "deleteClientCa",
	"summary": "Delete a Client CA",
	"description": "Fails while the CA is used by an Access List.",
	"tags": [
		"client-cas"
	],
	"security": [
		{
			"bearerAuth": [
				"access_lists.manage"
			]
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "caID",
			"description": "Client CA ID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 1
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"schema": {
						"type": "boolean"
					},
					"examples": {
						"default": {
							"value": true
						}
					}
				}
			}
		}
	}
}
