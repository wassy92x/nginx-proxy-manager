{
	"operationId": "downloadClientCa",
	"summary": "Download the CA certificate",
	"tags": [
		"client-cas"
	],
	"security": [
		{
			"bearerAuth": [
				"access_lists.view"
			]
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "caID",
			"description": "Client CA ID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 1
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/x-pem-file": {
					"schema": {
						"type": "string"
					}
				}
			}
		}
	}
}
